# Tinyauth's secrets; on the host they come from Vaultwarden (secrets-map.json). Prod only: dev/QA
# uses home-stack's Tinyauth. They are the OIDC client you create in Pocket ID (Settings > OIDC Clients > Add) after its
# first start, with the callback URL https://<TAUTH_HOST>/api/oauth/callback/pocketid (see config/<environment>.env), then
# `docker compose restart tinyauth`.
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET=
