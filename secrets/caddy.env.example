# The ingest secret; on the host it comes from secrets/<environment>/caddy.env (SOPS-encrypted). Caddy has no other
# secrets. deploy.sh puts this one in .env, where Compose fills it into the VictoriaLogs and VictoriaMetrics routes' labels.
# Bearer token a client must send to ingest logs and metrics (see docker-compose.yml).
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LOGS_INGEST_TOKEN=
