# The broker's secrets for local development: copy this to .env and fill it in. On the hosts they come from the Vaultwarden
# items listed in secrets-map.json (see "Secrets" in the README).
FLASK_SECRET_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music (optional): a MusicKit key from an Apple Developer Program account (Certificates, Identifiers &
# Profiles > Keys, with Media Services/MusicKit ticked). The Team ID, the key's ID, and the .p8 file's text,
# newlines and all. Leave them empty to keep Apple Music off the config page.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Encrypts stored third-party credentials (Glowmarkt, Apple Music, GitHub) at rest. Losing it
# loses those credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# TfL's app key, for the settings page's stop search and naming saved stops. countdown's
# TfL providers have their own.
TFL_APP_KEY=

# Bearer token for the read-only GET /api/status/devices (e.g. for Home Assistant). Leave it
# empty to keep that endpoint off. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STATUS_TOKEN=

# Pocket ID, for the sign-up flow (POCKET_ID_URL is a setting, in config/<environment>.env). In Pocket ID, as an admin:
# Settings > Admin > API Keys > Add API Key; and User Groups > `countdown`, whose id is in its URL.
POCKET_ID_API_KEY=
POCKET_ID_COUNTDOWN_GROUP_ID=
