# Production's settings: everything that differs between environments and isn't secret (the secrets are in
# Vaultwarden, per secrets-map.json). deploy-context.sh stages this as settings.env next to docker-compose.yml, and
# the services that need them list it in their env_file. Keep the keys in step with dev.env (a test checks).

# Which environment this is. The web pages show a banner and a title prefix in any but prod.
ENVIRONMENT=prod

# The names Caddy serves (as labels in docker-compose.yml), each needing an A record in this environment's zone, countdown.run, to its edge.
# APP_HOST is the settings site, all of it behind the login but the sign-up page, /about and the static files.
# API_HOST is the screens' API (and the status endpoint), with no login: each call carries its own secret.
# APEX_HOST and www. redirect to APP_HOST. LEGACY_HOST is the single name both used to share: it still answers the
# screens' API, for boards flashed before the split, and sends everything else to APP_HOST.
APEX_HOST=countdown.run
APP_HOST=app.countdown.run
API_HOST=api.countdown.run
LEGACY_HOST=auth.countdown.run
# Tinyauth, the login in front of the protected routes, and Pocket ID, the passkey provider behind it. Pocket ID's name is
# permanent: passkeys are bound to it.
TAUTH_HOST=tauth.countdown.run
ID_HOST=id.countdown.run
LOGS_HOST=logs.countdown.run
METRICS_HOST=metrics.countdown.run

# Spotify sends the listener back here after they sign in; the same address is registered in the Spotify app.
SPOTIFY_REDIRECT_URI=https://app.countdown.run/auth/spotify/callback

# The settings site's own address, which the broker can't tell is https behind the proxy.
SITE_URL=https://app.countdown.run

# Pocket ID's address as the broker calls its API (sign-up adds users to the `countdown` group). Its key and the group's id
# are POCKET_ID_API_KEY and POCKET_ID_COUNTDOWN_GROUP_ID in Vaultwarden (broker.env in secrets-map.json).
POCKET_ID_URL=https://id.countdown.run

# Whether this environment runs its own reverse proxy (the compose profile `edge`: Caddy; the Docker network `edge` is
# created here) or joins one that exists (home-stack's, an external network `edge`). See docker-compose.yml.
EDGE_OWNED=true
