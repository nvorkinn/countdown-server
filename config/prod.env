# Production's settings: everything that differs between environments and isn't secret (the secrets are in
# secrets/prod/). The release bundle for this environment installs this as settings.env next to docker-compose.yml, and
# the services that need them list it in their env_file. Keep the keys in step with dev.env (a test checks).

# The names Caddy serves, each needing an A record to this environment's host. APEX_HOST and www. redirect to AUTH_HOST.
APEX_HOST=nikolaivorkinn.com
AUTH_HOST=auth.nikolaivorkinn.com
SSO_HOST=sso.nikolaivorkinn.com
LOGS_HOST=logs.nikolaivorkinn.com
METRICS_HOST=metrics.nikolaivorkinn.com

# Spotify sends the listener back here after they sign in; the same address is registered in the Spotify app.
SPOTIFY_REDIRECT_URI=https://auth.nikolaivorkinn.com/auth/spotify/callback

# The sender of authentik's sign-up and recovery emails (a domain Resend is set up for).
AUTHENTIK_EMAIL__FROM=noreply@nikolaivorkinn.com
