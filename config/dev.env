# dev/QA's settings: everything that differs between environments and isn't secret (the secrets are in
# Vaultwarden, per secrets-map.json). deploy-context.sh stages this as settings.env next to docker-compose.yml, and
# the services that need them list it in their env_file. Keep the keys in step with prod.env (a test checks).

# Which environment this is. The web pages show a banner and a title prefix in any but prod.
ENVIRONMENT=dev

# The names Caddy serves (as labels in docker-compose.yml), each needing a DNS record in this environment's zone, countdown.build (dev: CNAMEs to home.vorkinn.org, the home server, see infra/cloudflare). APEX_HOST and www. redirect to AUTH_HOST.
APEX_HOST=countdown.build
AUTH_HOST=auth.countdown.build
# Tinyauth, the login in front of the protected routes, and Pocket ID, the passkey provider behind it: dev's own (not
# home-stack's), served by home-stack's Caddy. Pocket ID's name is permanent: passkeys are bound to it.
TAUTH_HOST=tauth.countdown.build
ID_HOST=id.countdown.build
LOGS_HOST=logs.countdown.build
METRICS_HOST=metrics.countdown.build

# Spotify sends the listener back here after they sign in; the same address is registered in the Spotify app.
SPOTIFY_REDIRECT_URI=https://auth.countdown.build/auth/spotify/callback

# The settings site's own address, which the broker can't tell is https behind the proxy.
SITE_URL=https://auth.countdown.build

# Pocket ID's address as the broker calls its API (sign-up adds users to the `countdown` group). Its key and the group's id
# are POCKET_ID_API_KEY and POCKET_ID_COUNTDOWN_GROUP_ID in Vaultwarden (broker.env in secrets-map.json).
POCKET_ID_URL=https://id.countdown.build

# Whether this environment runs its own reverse proxy (the compose profile `edge`: Caddy; the Docker network `edge` is
# created here) or joins one that exists (home-stack's, an external network `edge`). See docker-compose.yml.
EDGE_OWNED=false
