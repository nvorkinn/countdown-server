# dev/QA's settings: everything that differs between environments and isn't secret (the secrets are in
# secrets/dev/). The release bundle for this environment installs this as settings.env next to docker-compose.yml, and
# the services that need them list it in their env_file. Keep the keys in step with prod.env (a test checks).

# Which environment this is. The web pages show a banner and a title prefix in any but prod.
ENVIRONMENT=dev

# The names Caddy serves, each needing an A record to this environment's host. APEX_HOST and www. redirect to AUTH_HOST.
APEX_HOST=dev.nikolaivorkinn.com
AUTH_HOST=auth.dev.nikolaivorkinn.com
SSO_HOST=sso.dev.nikolaivorkinn.com
LOGS_HOST=logs.dev.nikolaivorkinn.com
METRICS_HOST=metrics.dev.nikolaivorkinn.com

# Spotify sends the listener back here after they sign in; the same address is registered in the Spotify app.
SPOTIFY_REDIRECT_URI=https://auth.dev.nikolaivorkinn.com/auth/spotify/callback

# The sender of authentik's sign-up and recovery emails (a domain Resend is set up for).
AUTHENTIK_EMAIL__FROM=noreply@nikolaivorkinn.com

# THE MAX MIX (github.com/nvorkinn/the-max-mix), a Spotify web app run from its own image, which every dev/QA release
# pulls the latest of. Dev/QA only for now: prod.env has none of these, and Caddy, Terraform and the deploy skip it.
# MAXMIX_HOST needs a (proxied) record and sits behind Cloudflare Access; the app also checks the Access token itself.
# The redirect URI to register in the Spotify app is https://<MAXMIX_HOST>/api/auth/callback. After the first apply of
# infra/cloudflare, copy its maxmix_access_aud output into MAXMIX_ACCESS_AUD (until then the app answers 503); the team
# domain is the one chosen when Zero Trust was set up.
MAXMIX_HOST=spotify.dev.nikolaivorkinn.com
MAXMIX_ACCESS_TEAM_DOMAIN=
MAXMIX_ACCESS_AUD=
