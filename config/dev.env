# dev/QA's settings: everything that differs between environments and isn't secret (the secrets are in
# secrets/dev/). The release bundle for this environment installs this as settings.env next to docker-compose.yml, and
# the services that need them list it in their env_file. Keep the keys in step with prod.env (a test checks).

# Which environment this is. The web pages show a banner and a title prefix in any but prod.
ENVIRONMENT=dev

# The names Caddy serves (as labels in docker-compose.yml), each needing an A record to this environment's edge. APEX_HOST and www. redirect to AUTH_HOST.
APEX_HOST=dev.nikolaivorkinn.com
AUTH_HOST=auth.dev.nikolaivorkinn.com
# Tinyauth, the login in front of the protected routes, and Pocket ID, the passkey provider behind it. Pocket ID's name is
# permanent: passkeys are bound to it.
TAUTH_HOST=tauth.dev.nikolaivorkinn.com
ID_HOST=id.dev.nikolaivorkinn.com
LOGS_HOST=logs.dev.nikolaivorkinn.com
METRICS_HOST=metrics.dev.nikolaivorkinn.com

# Spotify sends the listener back here after they sign in; the same address is registered in the Spotify app.
SPOTIFY_REDIRECT_URI=https://auth.dev.nikolaivorkinn.com/auth/spotify/callback

# The settings site's own address, which the broker can't tell is https behind the proxy.
SITE_URL=https://auth.dev.nikolaivorkinn.com

# Pocket ID's address as the broker calls its API (sign-up adds users to the `countdown` group). Its key and the group's id
# are POCKET_ID_API_KEY and POCKET_ID_COUNTDOWN_GROUP_ID in secrets/dev/broker.env.
POCKET_ID_URL=https://id.dev.nikolaivorkinn.com

# Whether this environment runs its own edge (the compose profile `edge`: Caddy, Tinyauth, Pocket ID; the Docker network
# `edge` is created here) or joins one that exists (home-stack's, an external network `edge`). See docker-compose.yml.
EDGE_OWNED=false
